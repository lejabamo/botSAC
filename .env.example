# ==============================================================================
# BOTSAC ENTERPRISE - CONFIGURACIÓN DE PRODUCCIÓN (.env.example)
# Copiar este archivo a .env y suministrar las credenciales del entorno.
# NUNCA subir archivos .env con credenciales reales a GitHub.
# ==============================================================================

# Credenciales y URL del Portal SAC Institucional
SAC_URL=https://sac2.gestionsecretariasdeeducacion.gov.co/app_Login/
SAC_USER=usuario_sac_institucional
SAC_PASS=contrasena_sac_institucional

# Credenciales de Usuarios de Prueba / Roles BotSAC
BOTSAC_PASS_LJBASTIDAS=contrasena_lider_oficina
BOTSAC_PASS_ADIAZ=contrasena_funcionario

# Conexión Oracle Database 19c Enterprise
ORACLE_USER=BOTSAC
ORACLE_PASS=contrasena_oracle_segura
ORACLE_HOST=172.16.0.10
ORACLE_PORT=1521
ORACLE_SERVICE=pdb_dev.educauca.gov.co
# Alternativamente, DSN completo:
# ORACLE_DSN=172.16.0.10:1521/pdb_dev.educauca.gov.co

# Ruta a librerías Oracle Instant Client (Thick Mode)
# En Linux: /opt/oracle/instantclient_19_23
# En Windows: instantclient/instantclient_19_32
ORACLE_CLIENT_LIB_DIR=instantclient/instantclient_19_32

# Configuración de Inteligencia Artificial / LLM
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2

